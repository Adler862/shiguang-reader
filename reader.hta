<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="x-ua-compatible" content="ie=edge">
<title>拾光 · 极简阅读器</title>
<hta:application id="oApp"
  applicationname="ShiGuangReader"
  border="dialog"
  caption="yes"
  contextmenu="no"
  innerborder="no"
  maximizebutton="no"
  minimizebutton="yes"
  navigable="no"
  scroll="no"
  selection="no"
  showintaskbar="yes"
  singleinstance="yes"
  sysmenu="yes"
  version="2.0"
  windowstate="normal" />
<style>
html,body{margin:0;padding:0;width:100%;height:100%;background:#F3EAD9;color:#4A3D2E;font-family:"Microsoft YaHei","Segoe UI",sans-serif}
body{display:table;text-align:center}
.box{display:table-cell;vertical-align:middle;padding:0 26px}
.logo{width:64px;height:64px;margin:0 auto 12px;border-radius:18px;background:#A8804E;color:#FDF8EC;font:36px/64px Georgia,SimSun,serif}
h1{margin:0 0 6px;font-size:20px;font-weight:normal;font-family:Georgia,SimSun,serif}
p{margin:4px 0;font-size:13px;color:#8A7A63;line-height:1.8}
#status{color:#6B5B45}
.err{color:#B04A3A !important}
.ok{color:#3E7A4E !important}
</style>
<script>
(function(){
var C1="";
var C2="";
var C3="";
var C4="";
var PAYLOAD=C1+C2+C3+C4;
function $(id){ return document.getElementById(id); }
function setStatus(msg, cls){ var el=$('status'); el.innerHTML=msg; el.className=cls||''; }
function utf8ToStr(bin){
  var out='', i=0, n=bin.length;
  while(i<n){
    var c=bin.charCodeAt(i);
    if(c<128){ out+=String.fromCharCode(c); i+=1; }
    else if((c&224)===192){
      out+=String.fromCharCode(((c&31)<<6)|(bin.charCodeAt(i+1)&63)); i+=2;
    }
    else if((c&240)===224){
      var cp=((c&15)<<12)|((bin.charCodeAt(i+1)&63)<<6)|(bin.charCodeAt(i+2)&63);
      out+=String.fromCharCode(cp); i+=3;
    }
    else if((c&248)===240){
      var cp=((c&7)<<18)|((bin.charCodeAt(i+1)&63)<<12)|((bin.charCodeAt(i+2)&63)<<6)|(bin.charCodeAt(i+3)&63);
      if(cp>=65536){ cp-=65536; out+=String.fromCharCode(55296|(cp>>10),56320|(cp&1023)); }
      else{ out+=String.fromCharCode(cp); }
      i+=4;
    }
    else{ out+=String.fromCharCode(c); i+=1; }
  }
  return out;
}
function launch(path, cb){
  var url='file:///'+path.replace(/\\/g,'/');
  var shell;
  try{ shell=new ActiveXObject('WScript.Shell'); }
  catch(e){ return cb('无法创建系统组件：'+(e.description||e.message||e)); }
  var fso=null;
  try{ fso=new ActiveXObject('Scripting.FileSystemObject'); }catch(e){}
  var roots=[];
  try{ roots.push(shell.ExpandEnvironmentStrings('%ProgramFiles(x86)%')); }catch(e){}
  try{ roots.push(shell.ExpandEnvironmentStrings('%ProgramFiles%')); }catch(e){}
  var edge=null;
  if(fso){
    for(var i=0;i<roots.length;i++){
      var f=roots[i]+'\\Microsoft\\Edge\\Application\\msedge.exe';
      try{ if(fso.FileExists(f)){ edge=f; break; } }catch(e){}
    }
  }
  var cmd;
  if(edge){ cmd='"'+edge+'" --app="'+url+'"'; }
  else{ cmd='rundll32 url.dll,FileProtocolHandler "'+url+'"'; }
  try{ shell.Run(cmd, 1, false); cb(null); }
  catch(e){ cb('启动阅读器失败：'+(e.description||e.message||e)); }
}
function run(){
  setStatus('正在准备离线阅读器…');
  var fso;
  try{ fso=new ActiveXObject('Scripting.FileSystemObject'); }
  catch(e){ return fail('系统安全设置阻止了启动器运行。请直接双击同目录下的「reader.html」。'); }
  var dir;
  try{ dir=fso.GetSpecialFolder(2).Path+'\\ShiGuangReader'; }
  catch(e){ return fail('无法定位系统临时目录。'); }
  var path=dir+'\\reader.html';
  try{
    if(!fso.FolderExists(dir)) fso.CreateFolder(dir);
    var ts=fso.CreateTextFile(path, true, true);
    ts.Write(utf8ToStr(atob(PAYLOAD)));
    ts.Close();
  }catch(e){
    return fail('无法写入本地文件：'+(e.description||e.message||e)+'<br>请右键本文件，选择「属性」解除锁定后重试；<br>或直接双击同目录下的「reader.html」。');
  }
  setStatus('正在打开阅读窗口…');
  launch(path, function(err){
    if(err){ fail(err); return; }
    setStatus('已打开，本窗口即将自动关闭', 'ok');
    setTimeout(function(){ try{ window.close(); }catch(e){} }, 700);
  });
}
function fail(msg){ setStatus(msg, 'err'); }
window.onload=function(){
  try{ window.resizeTo(430,250); window.moveTo((screen.availWidth-430)/2,(screen.availHeight-250)/2); }catch(e){}
  run();
};
})();
</script>
</head>
<body>
<div class="box">
  <div class="logo">读</div>
  <h1>拾光 · 极简阅读器</h1>
  <p id="status">正在启动…</p>
  <p>完全离线 · 无需安装 · 双击即用</p>
</div>
</body>
</html>
